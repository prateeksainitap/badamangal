// BadaMangal - Prisma schema
//
// Production: Postgres on Neon.
// Local dev: also Postgres (run a local docker container or just point at a
// dev Neon branch). The schema is portable - JSON-shaped string columns
// stay strings so the existing TS types don't need to change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bhandara {
  id                String    @id @default(cuid())
  slug              String    @unique
  // names
  name              String
  nameHi            String?
  description       String?
  descriptionHi     String?
  // location
  address           String
  addressHi         String?
  area              String // user-facing curated tag (Aliganj, Hazratganj, ...)
  landmark          String?
  lat               Float
  lng               Float
  // geocoder-derived (truth from Nominatim/Google)
  geoNeighborhood   String?
  geoDistrict       String?
  geoState          String?
  googlePlaceId     String?
  googleMapsUrl     String?
  // schedule (JSON-encoded; SQLite has no native arrays)
  tuesdayDates      String // JSON string[] of ISO dates
  timeStart         String // "HH:MM" 24h
  timeEnd           String // "HH:MM" 24h
  // serving
  menu              String // JSON string[] (English keys)
  menuHi            String // JSON string[] (Devanagari labels)
  // contact
  organizerName     String
  organizerPhone    String
  organizerWhatsapp String?
  upiId             String?
  /// URL of an uploaded UPI QR-code image (R2 / Supabase). Optional
  /// companion to `upiId` - some organisers only know their UPI as
  /// a printed QR (no idea of the text VPA underneath), and a few
  /// scan-and-publish cases want a custom QR (combo Razorpay /
  /// dynamic-amount). Public render falls back to upiId-generated QR
  /// when this column is null. Image is uploaded via the existing
  /// /api/uploads pipeline (sharp normalize + R2), so the URL is on
  /// cdn.badamangal.com just like photoUrl.
  upiQrUrl          String?
  /// Reverse relation to DonationIntent - every sponsor tap on this
  /// bhandara creates one row. NOT loaded by default on public reads;
  /// the admin /admin/donations queue is the only consumer today.
  donationIntents   DonationIntent[]
  // media
  photoUrl          String?
  // moderation
  // Listings go live as soon as the organizer's mobile is OTP-verified
  // (status = APPROVED). A separate `isVerified` flag flips to true once
  // the BadaMangal team independently confirms the details by phone, at
  // which point a "Verified" badge appears on the listing.
  status            String    @default("APPROVED") // APPROVED | REJECTED | ARCHIVED
  isVerified        Boolean   @default(false)
  isSponsored       Boolean   @default(false)
  // Admin-controlled "feature this bhandara" flag. When true, the
  // bhandara jumps to the top of the FeaturedBhandaras (homepage)
  // priority order, regardless of date / photo / verification.
  // Toggled via the admin edit page (see editAndPublishAction).
  // Distinct from isSponsored (which connotes "paid us") and
  // isVerified (which connotes "we've confirmed the details").
  isFeatured        Boolean   @default(false)
  sponsorTier       String?
  // metrics
  viewCount         Int       @default(0)
  shareCount        Int       @default(0)
  // timestamps
  createdAt         DateTime  @default(now())
  approvedAt        DateTime?

  // user-submitted spots that point at this bhandara
  spots Spot[]

  @@index([status])
  @@index([area])
}

// Single-row counter table for site-wide stats (visitor count, etc.).
// Keyed by name so we can add more counters later (homeVisits, listings, …).
model SiteCounter {
  id        String   @id
  count     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt
}

// ── Spotted bhandaras (live, ephemeral) ─────────────────────────────────
//
// A "Spot" is a quick crowd-sourced report: someone walking past a bhandara
// snaps a photo and drops a pin so the city map can show what's actually
// happening RIGHT NOW. Unlike a Bhandara listing, a Spot:
//  - has no schedule, organizer, menu (optional caption only)
//  - auto-expires after `expiresAt` (defaults to 8 hours)
//  - is OK to submit anonymously (no OTP gate by default)
//
// The map and "Happening now" feed read these where status=APPROVED and
// expiresAt > now().
model Spot {
  id                String    @id @default(cuid())
  // location
  lat               Float
  lng               Float
  area              String? // optional curated tag (Aliganj, Gomti Nagar, …)
  address           String? // free-text or reverse-geocoded
  // content
  photoUrl          String? // primary photo (back-compat: existing rows + Card thumbnail)
  // JSON-encoded array of extra photo URLs (up to 5). Same string-of-JSON
  // pattern VolunteerSubmission uses, so the Supabase pooler doesn't have
  // to do prepared statements against a Postgres text[] column. Read on
  // the client via JSON.parse(extraPhotoUrls || "[]").
  extraPhotoUrls    String    @default("[]")
  caption           String? // 0–200 chars
  language          String    @default("en") // "hi" | "en" | "mixed"
  // optional reporter (we don't require it but record if given)
  reporterName      String?
  reporterPhoneHash String?
  // moderation
  status            String    @default("APPROVED") // PENDING | APPROVED | REJECTED
  rejectReason      String?
  reportCount       Int       @default(0)
  // lifecycle
  createdAt         DateTime  @default(now())
  expiresAt         DateTime // typically createdAt + 8h
  // optional link to a fully-listed bhandara (if one matches)
  bhandaraId        String?
  bhandara          Bhandara? @relation(fields: [bhandaraId], references: [id])
  // metadata
  ipHash            String
  userAgent         String?

  @@index([status, expiresAt])
  @@index([area, status])
}

// ── Contact-form messages ───────────────────────────────────────────────
//
// Submissions from the public /contact form. We store rather than email so
// nothing is lost if mail-out fails, and the team can triage from /admin.
// Honeypot field + IP hash deter the cheapest spam - real abuse will need
// a Captcha bolted on later.
model ContactMessage {
  id             String   @id @default(cuid())
  name           String
  email          String
  phone          String?
  subject        String?
  message        String
  // optional supporting document (PDF or image), uploaded via /api/uploads
  // and referenced here by its public URL. Original filename kept so the
  // moderator sees the user's intent (e.g. "school-id.pdf").
  attachmentUrl  String?
  attachmentName String?
  attachmentType String? // "pdf" | "image"
  // moderation
  status         String   @default("NEW") // NEW | READ | REPLIED | SPAM
  // metadata
  createdAt      DateTime @default(now())
  ipHash         String
  userAgent      String?

  @@index([status, createdAt])
}

// ── Organise-Bhandara requests ──────────────────────────────────────────
//
// Lead-capture rows from /organise-bhandara, the full-service module
// where the team helps an organiser arrange a bhandara (tent, catering,
// logistics, etc.). Same store-then-email pattern as ContactMessage so
// nothing is lost if mail-out fails, and the team can triage by status
// in the admin queue.
//
// quantityType + quantityValue model "how big a bhandara?" Two units the
// organiser can express it in:
//   PLATES   → headcount served (e.g. 500 plates)
//   WHEAT_KG → kg of wheat / atta to be cooked (e.g. 200 kg)
// We capture whichever the organiser is comfortable with; the team
// normalises internally during the follow-up call.
//
// packageTier is what they picked off the public packages section, or
// "CUSTOM" if they built their own request from the form. Lets us
// segment by package-tier conversion in the queue.
model OrganiseRequest {
  id            String   @id @default(cuid())
  // contact
  name          String
  phone         String
  email         String?
  // event
  area          String? // Lucknow neighbourhood (free-form)
  addressNotes  String? // landmark / venue / extra location detail
  // JSON-encoded array of ISO YYYY-MM-DD strings. Nullable because
  // organisers sometimes ask before they've fixed any dates; the
  // form supports both the preset season chips (Bada Mangal Tuesdays
  // + Bade Shanivars) and any custom date inside the season window
  // via the shared SeasonDatePicker. Stored as JSON-in-string for
  // parity with Bhandara.tuesdayDates so the same safeJsonArray
  // reader can decode it.
  eventDates    String? // JSON string[] of ISO dates, e.g. ["2026-05-19","2026-05-26"]
  eventTime     String? // HH:MM
  // size
  quantityType  String // "PLATES" | "WHEAT_KG"
  quantityValue Int // 50 .. ~10000
  packageTier   String // "SMALL" | "MEDIUM" | "LARGE" | "CUSTOM"
  // misc
  notes         String? // free-form additional requirements
  // moderation
  status        String   @default("NEW") // NEW | CONTACTED | CONFIRMED | COMPLETED | REJECTED
  // attribution: where the user clicked through from
  // (page | banner | upsell | footer | other)
  source        String?
  // metadata
  createdAt     DateTime @default(now())
  ipHash        String
  userAgent     String?

  @@index([status, createdAt])
}

// ──────────────────────────────────────────────────────────────────
// Volunteer programme (Tier A - minimal, no OTP)
// ──────────────────────────────────────────────────────────────────
//
// Pays community volunteers ₹50 per complete bhandara documented:
// 10 photos (2-3 each: Venue/People/Food/Banner) + 2 videos + 1
// live-spot photo + the listing form fields. Recruit students /
// devotees / delivery boys to scale the directory faster than we
// can ingest via the WhatsApp bot alone.
//
// Auth model (deliberately minimal for v1): each Volunteer gets a
// random 6-char code (BM-LKO-X7K2M9) at signup. That code IS the
// auth - anyone with it can submit. No OTP, no session cookie. The
// code is ~2 billion possibilities so brute-force is impractical;
// admin moderation is the final quality gate; we rate-limit
// signups per-IP and submissions per-code to keep abuse bounded.
// Tier B will add WhatsApp OTP + a real dashboard.

model Volunteer {
  id         String    @id @default(cuid())
  // Human-readable code, e.g. "BM-LKO-X7K2M9". Random alphanumeric
  // suffix (not sequential) so unauthenticated guessing is hard.
  // Format also doubles as the volunteer-facing identifier in
  // admin payout exports + WhatsApp coordination.
  //
  // NULLABLE because the code is issued ONLY after an admin
  // approves the signup (PENDING → PROBATIONARY transition). At
  // signup time the row is created with status=PENDING and code=null
  // so the volunteer can't submit until the admin has verified
  // their WhatsApp number works + that they're a real person.
  // Postgres allows multiple NULLs in a UNIQUE column, so the
  // @unique here gates issued codes only.
  code       String?   @unique
  name       String
  // 10-digit Indian mobile, no +91 prefix (validated at signup).
  // Doubles as the WhatsApp number - admin clicks the wa.me link
  // generated by approveAndIssueVolunteerCodeAction to deliver the
  // code, which both issues the code AND verifies the number is
  // a real reachable WhatsApp (failed sends = bounce back to admin).
  phone      String
  // UPI ID for weekly payouts. Free-form because the formats vary
  // (9876543210@upi, name@paytm, name@okhdfcbank, etc.). We do NOT
  // attempt validation beyond non-empty + reasonable length.
  upi        String
  // JSON-encoded string[] of Lucknow areas the volunteer claims to
  // cover. Informational only - we don't restrict their submissions
  // to these areas. Helps admin see "who's available where".
  areas      String    @default("[]")
  // Lifecycle:
  //   PENDING       → fresh signup, code not yet issued, can't submit
  //   PROBATIONARY  → admin approved + code sent via WhatsApp;
  //                   first 3 submissions reviewed strictly
  //   TRUSTED       → admin promoted after sustained accuracy;
  //                   submissions can be auto-approved (Tier B+)
  //   SUSPENDED     → fraud / repeated rejects, code invalidated
  // No automatic tier promotion in Tier A - admin manual toggle.
  status     String    @default("PENDING")
  // Free-form admin notes (e.g. "called to verify identity",
  // "recruited from IIM-L group", "kicked out after 3 fake photos").
  notes      String?
  createdAt  DateTime  @default(now())
  // Bot-friendly: same notification pattern as OrganiseRequest so
  // the bot can announce new volunteer signups to the team group
  // for awareness. NULL = not yet broadcast.
  notifiedAt DateTime?
  ipHash     String
  userAgent  String?

  submissions VolunteerSubmission[]

  @@index([code])
  @@index([status, createdAt])
  @@index([notifiedAt])
}

model VolunteerSubmission {
  id            String    @id @default(cuid())
  volunteerId   String
  volunteer     Volunteer @relation(fields: [volunteerId], references: [id])
  // Denormalised copy of the volunteer code for fast admin filtering
  // without joining. Kept in sync at submit time.
  volunteerCode String

  // ─── Bhandara info (the listing the volunteer captured) ─────────
  bhandaraName   String
  area           String
  address        String
  organizerName  String?
  organizerPhone String? // 10 digits if visible on banner
  startTime      String? // e.g. "9:00 AM" (free-form, normalised on Bhandara create)
  menu           String? // comma-separated (e.g. "puri, sabzi, halwa")

  // ─── Proof (the ₹50-bundle: 10 photos + 2 videos + 1 spot) ──────
  // JSON-encoded string[] of Supabase Storage URLs. We use String
  // (not arrays) for parity with Bhandara.tuesdayDates which is
  // also JSON-in-string; same safeJsonArray reader works.
  photoUrls    String  @default("[]") // up to 10 URLs
  videoUrls    String  @default("[]") // up to 2 URLs
  spotPhotoUrl String? // the one "live now" photo for the city map

  // ─── Location (auto-captured at submit time) ────────────────────
  // Browser geolocation API result + optional pasted Google Maps
  // link. We store both because GPS is the abuse-proof signal
  // (proves they were physically there) and the maps link is the
  // admin-friendly one (can click to verify in browser).
  gpsLat  Float?
  gpsLng  Float?
  mapsUrl String?

  // ─── Moderation + payout ────────────────────────────────────────
  // NEW        - fresh submission, awaiting admin review
  // APPROVED   - full bundle ✓, ₹50 payout owed
  // PARTIAL    - most-of-bundle ✓, ₹25 payout owed (admin discretion)
  // REJECTED   - fraud / incomplete / no payout
  // DUPLICATE  - same bhandara already submitted by another volunteer
  status       String    @default("NEW")
  // Set at approval time. Defaults to 0 so unreviewed rows don't
  // pollute the "owed" total. Admin can override for special cases.
  payoutAmount Int       @default(0)
  adminNotes   String?
  reviewedAt   DateTime?
  // When the admin actually paid out (manual UPI for Tier A,
  // automated for Tier B+). NULL = approved but not yet paid.
  paidAt       DateTime?
  paymentRef   String? // UPI transaction reference if applicable

  // ─── Cross-links: did this submission become a Bhandara + Spot? ─
  // When admin approves, we auto-create a Bhandara row from the
  // submission data + a Spot row from the spot photo. These IDs
  // let admin see "this submission produced these public rows"
  // and lets us avoid double-creating if approve is clicked twice.
  resultingBhandaraId String?
  resultingSpotId     String?

  // ─── Metadata ───────────────────────────────────────────────────
  volunteerNotes String? // free-form notes from the volunteer
  createdAt      DateTime @default(now())
  userAgent      String?
  ipHash         String?

  @@index([volunteerId, createdAt])
  @@index([status, createdAt])
  @@index([volunteerCode, createdAt])
}

/// Auto-fetched news items related to Bada Mangal in Lucknow, populated
/// from Google News RSS + select direct publisher RSS feeds by
/// `src/lib/news-aggregator.ts` on a periodic trigger (admin-triggerable
/// + cron). One row per unique source URL.
/// Auto-publish from a strict source whitelist (see aggregator's
/// SOURCE_WHITELIST); admin can flip status to "HIDDEN" via the admin
/// queue to suppress an individual item without losing the dedup
/// fingerprint (we never re-fetch a hidden URL).
model NewsItem {
  id          String   @id @default(cuid())
  // Resolved article URL (Google News redirects get resolved before
  // insert when possible; otherwise the raw redirect URL is stored
  // - browsers follow it fine and the unique constraint still works).
  url         String   @unique
  title       String
  // Source name as it appears in the Google News feed (e.g. "Dainik
  // Jagran", "The Times of India"). Used for the source-pill on the
  // card + for whitelist matching when re-fetching.
  source      String
  // BCP-47ish: "en" or "hi". The two RSS queries are run separately
  // so we always know the language at insert time without needing
  // language detection.
  language    String   @default("en")
  // Article publish timestamp parsed from the RSS <pubDate>.
  publishedAt DateTime
  // Optional OG image URL scraped from the article page. May be
  // null for v1; the page falls back to a per-source brand colour
  // when absent so cards never look broken.
  imageUrl    String?
  // APPROVED  - auto-published, visible on the news page
  // HIDDEN    - admin manually hid this item (kept as a tombstone
  //             so the URL never re-publishes)
  // The aggregator inserts as APPROVED for whitelisted sources; the
  // admin flips to HIDDEN via /admin/news (queue UI), never deletes.
  status      String   @default("APPROVED")
  createdAt   DateTime @default(now())

  @@index([status, publishedAt])
  @@index([language, status, publishedAt])
}

/// Admin-curated photos for the homepage gallery section. Sits
/// alongside auto-pulled photos from Spot rows (which the gallery
/// query unions in for visual density). Use cases:
///   • Editorial moments the admin photographed themselves
///   • Posters / pamphlets / community moments that don't fit the
///     spot-flow shape (no GPS, not time-bounded)
///   • Hand-uploaded crowd shots from past Tuesdays
/// Display order: `displayOrder ASC` first (admin can pin), then
/// `createdAt DESC`. Hidden items keep their row (admin can flip
/// status to bring back) but never render publicly.
model GalleryPhoto {
  id           String   @id @default(cuid())
  imageUrl     String // Supabase storage URL
  caption      String? // optional 0–140 chars
  captionHi    String? // Hindi caption, optional
  // Display order: lower = surfaces earlier in the gallery. Used
  // for "pin this photo to the top of the gallery" admin action.
  // Defaults to 100 so new uploads land in the middle and can be
  // pulled up via the admin.
  displayOrder Int      @default(100)
  // VISIBLE  - renders publicly
  // HIDDEN   - admin pulled it back without deleting
  status       String   @default("VISIBLE")
  createdAt    DateTime @default(now())
  uploadedBy   String? // free-form note like "Prateek", "Akanksha"
  // Free-form tags for the Content Hub Images tab. Conventions:
  //   "ig" | "wa" | "reddit" | "press" | "pamphlet" | "brand"
  //   | "community" | "ai-generated"
  // Empty = legacy photo (homepage gallery only); populated = the
  // image ALSO surfaces in /admin/content under the Images tab,
  // filterable by tag. Same row can carry multiple tags.
  tags         String[] @default([])

  @@index([status, displayOrder, createdAt])
  @@index([tags])
}

// ──────────────────────────────────────────────────────────────────
// Content Hub - pitches, templates, strategy docs
// ──────────────────────────────────────────────────────────────────
//
// Centralised store for everything the admin sends OUT to the world:
// sponsor pitches, influencer outreach, press release drafts,
// WhatsApp / email templates for organisers / volunteers / donors,
// strategy memos, prompts library (the LLM-runnable stuff lives in
// the Prompt model below). Rendered + edited via /admin/content.
//
// Seeded one-shot from /notes/*.md files via importNotesAction.
// After seed, the markdown source is no longer canonical - the DB
// row is. Re-running import is idempotent (skips on duplicate title).
model Content {
  id          String   @id @default(cuid())
  // Drives which tab the card appears in inside /admin/content.
  //   PITCH      - pitch decks / cold outreach (sponsor, influencer, press)
  //   TEMPLATE   - copy-paste templates (WhatsApp / email / IG caption)
  //   STRATEGY   - long-form planning docs (off-season strategy, personas)
  //   OTHER      - catch-all
  kind        String   @default("PITCH")
  // Fine-grained audience - drives filter chips inside each tab.
  //   SPONSOR | INFLUENCER | PRESS | ORGANISER | VOLUNTEER | DONOR
  //   | COMMUNITY | INTERNAL | OTHER
  audience    String   @default("OTHER")
  // Distribution channel - drives a second filter dimension.
  //   INSTAGRAM | WHATSAPP | EMAIL | REDDIT | PRESS | INTERNAL | OTHER
  channel     String   @default("OTHER")
  // "en" | "hi" | "bilingual" - bilingual carries both in the body
  // separated by a `---` rule.
  language    String   @default("en")
  // Card title (shown in list).
  title       String
  // Markdown body. Editor is a plain <textarea>; viewer renders with
  // a minimal MD→HTML pipeline server-side (no client JS needed).
  // Copy-to-clipboard ships the plain markdown verbatim.
  body        String
  // One-line summary for the card preview / list item subtitle.
  summary     String?
  // Free-form tags for ad-hoc grouping ("jyeshtha", "off-season",
  // "tier-1-sponsor", etc.). Postgres native array - Prisma 5+ is
  // happy with this on PG, we don't need the JSON-in-string trick
  // older models used for SQLite parity.
  tags        String[] @default([])
  // Where this row came from - usually a `notes/NN-slug.md` filename
  // from the import seed. NULL for hand-written entries.
  source      String?
  // DRAFT    - work-in-progress, surfaces in the "Drafts" tile +
  //            row pill, NOT in the "Ready to send" count
  // ACTIVE   - ready / live, visible in the hub default view
  // ARCHIVED - hidden but kept for history (admin can flip back)
  status      String   @default("ACTIVE")
  // Free-form "last edited by" attribution. Defaults to "Prateek"
  // since this is a single-operator tool today.
  lastEditor  String?
  // Send-tracking, added 2026-05-27. Powers the Content Hub Mission
  // Strip (Ready / Drafts / Sent-this-week / Awaiting-reply tiles)
  // and the "Sent 3d ago to X" pill on each card. All three are
  // operator-managed via the Mark sent / Mark replied actions -
  // there's no automated detection, the operator owns the truth
  // because outbound (email, Instagram DM, WhatsApp, press) happens
  // outside the platform.
  /// Timestamp of the most recent "Mark sent" press for this row.
  /// NULL = never sent (or send history cleared).
  lastSentAt    DateTime?
  /// Free-form note for "who was this last sent to?" - operator
  /// keys in the recipient string ("Times of India · Ashish Kumar")
  /// when marking sent. Surfaces in the row's status pill.
  lastSentTo    String?
  /// True when the operator is expecting a reply, false when
  /// closed (replied / declined / lapsed). Drives the "Awaiting
  /// reply" mission tile and the follow-up filter.
  awaitingReply Boolean   @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, kind])
  @@index([kind, audience, channel])
  @@index([updatedAt])
  /// Used by the Mission Strip's "Sent 7d" tile and any future
  /// "sent in the last N days" filter; partial-index would be
  /// nicer (WHERE lastSentAt IS NOT NULL) but Prisma's index DSL
  /// doesn't expose that yet, plain B-tree handles it fine.
  @@index([lastSentAt])
  /// Powers the "Awaiting reply" Mission Strip tile + the
  /// follow-up filter list.
  @@index([awaitingReply, lastSentAt])
}

// ──────────────────────────────────────────────────────────────────
// Prompts library - runnable AI prompts
// ──────────────────────────────────────────────────────────────────
//
// Saved prompts that the admin can "Run with ChatGPT / Gemini" from
// the dashboard. Each row stores the prompt + the last run's output
// so the admin can re-read recent results without paying for another
// API call. Variables in the prompt body use {{double-brace}} syntax
// and the runner UI generates a text input per unique variable.
//
// Example body:
//   "Draft a WhatsApp message to {{name}} about organising a bhandara
//    in {{area}}. Mention {{detail}}. Sign as Prateek."
//
// Wired to OpenAI by default (gpt-4o-mini) with an option to override
// to gpt-4o per run. Gemini fallback uses the existing
// src/lib/vision.ts integration. See src/lib/openai.ts for the runner.
model Prompt {
  id            String    @id @default(cuid())
  title         String
  // The prompt template. May contain {{name}}-style placeholders.
  body          String
  // Optional system instruction prepended when calling the LLM.
  // Useful for setting tone ("You are Prateek, a community organiser…").
  systemPrompt  String?
  // Default model string passed to the OpenAI / Gemini SDK.
  //   "gpt-4o-mini" (cheap, fast)
  //   "gpt-4o" (smart, pricier)
  //   "gemini-2.5-flash" (free credits)
  defaultModel  String    @default("gpt-4o-mini")
  // Free-form tags ("outreach", "instagram-caption", "press-pitch",
  // "fundraising") for filter chips.
  tags          String[]  @default([])
  // Cache of the most recent run for quick re-display. We only store
  // the last run (not the full history) to keep this table small;
  // run-history can be added later if it becomes useful.
  lastRunAt     DateTime?
  lastRunModel  String?
  // Truncated to 8000 chars before insert (large GPT-4 responses
  // can run longer; admin can re-run if they need the full output).
  lastRunOutput String?
  // The variables substituted in the last run (JSON-encoded). Lets
  // the UI pre-fill the inputs when the admin re-opens the prompt.
  lastRunVars   String?
  // ACTIVE | ARCHIVED - same convention as Content.
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, updatedAt])
  @@index([tags])
}

/// WhatsApp text-message mentions of a bhandara (askings + answers +
/// general chatter). Fed by /api/bot/message which the OpenClaw agent
/// POSTs to whenever a message in an allowlisted WhatsApp group either
/// (a) asks "where is the bhandara today?", (b) tells where one is
/// happening, or (c) mentions the word bhandara in passing.
///
/// Separate model from `Spot` and `Bhandara` because the lifecycle is
/// different: a mention is ephemeral micro-content (24-48h public
/// lifespan), has no photo, may or may not carry a location, and the
/// public surface for it is the LiveChatterBoard on the homepage +
/// the mention-density heatmap that paints the city in colored zones
/// based on where the conversation is happening RIGHT NOW.
///
/// Schema design notes:
///   • `intent` is a coarse classifier output from Gemini: ASKING /
///     SHARING / MENTIONING / UNRELATED. UNRELATED never reaches the
///     DB (the endpoint discards before insert), but the enum carries
///     the label for consistency with the classifier return type.
///   • `lat`/`lng` are nullable, plenty of mentions have no location
///     ("anyone seen bhandara near Hazratganj today?"). When non-null,
///     they're guaranteed in the Lucknow bbox (filtered at insert).
///   • `locationSource` records how we got the coords so admins can
///     spot low-confidence sources (`extracted_address` is fuzzier
///     than a direct `whatsapp_share`).
///   • `msgId` is sparse-unique so cross-group re-forwards of the same
///     message (common with viral location shares) collapse to one row.
///   • `expiresAt` is set at insert time (now + 24h by default) and
///     drives the public-feed visibility window. Admins can extend
///     via the moderation page if a particularly useful mention
///     deserves a longer lifespan.
model BhandaraMention {
  id             String    @id @default(cuid())
  // raw message
  /// Verbatim WhatsApp text, truncated to 2000 chars at the endpoint.
  /// Kept for admin context even after `cleanedText` is generated.
  originalText   String
  /// PII-redacted + bot-tag-stripped text shown on the public feed.
  /// Phone numbers, email addresses, and the `[bot:whatsapp …]` block
  /// are scrubbed before this column is populated.
  cleanedText    String?
  language       String    @default("mixed") // hi | en | mixed
  // classification (Gemini)
  /// ASKING     - "kahan ho raha hai bada mangal bhandara today?"
  /// SHARING    - "Aliganj sector E me ho raha hai 11 baje se"
  /// MENTIONING - general bhandara chatter (photos, thanks, etc)
  /// UNRELATED  - non-bhandara content (filtered out before insert)
  intent         String    @default("MENTIONING")
  /// Gemini's self-reported confidence 0-1. Below 0.4 → auto-reject
  /// at the endpoint (don't even create a PENDING row).
  confidence     Float     @default(0)
  // location (optional)
  lat            Float?
  lng            Float?
  /// whatsapp_share | google_maps_url | extracted_address | manual | none
  locationSource String    @default("none")
  /// Human-friendly area label, "Hazratganj", "near GPO", etc. Often
  /// pulled from the same message text the location came from.
  locationLabel  String?
  // provenance
  groupName      String?
  senderName     String?
  /// WA message id; @unique so cross-group re-forwards dedupe to one row.
  msgId          String?   @unique
  /// When the WhatsApp message was a REPLY (Baileys' contextInfo.
  /// quotedMessage), we persist the quoted text + best-effort sender
  /// name so the chat panel can render the context strip above the
  /// reply bubble - "Malhaur" alone reads as a stray word; with
  /// "↳ Amity konsa wala - Rohit" above it, the user sees the answer
  /// is to that question. Nullable: most messages aren't replies.
  quotedText     String?
  quotedSender   String?
  // moderation
  /// PENDING (default) → APPROVED (visible on public feed + heatmap)
  /// or REJECTED (hidden, kept for audit). Auto-promotion can be
  /// added later for high-confidence SHARING mentions in
  /// allowlisted groups.
  status         String    @default("PENDING")
  /// Optional link to an existing Bhandara row when the admin matches
  /// the mention to a specific listing. Powers a "mentioned in chat"
  /// indicator on bhandara detail pages.
  bhandaraId     String?
  // timestamps
  createdAt      DateTime  @default(now())
  approvedAt     DateTime?
  /// Public-feed cutoff. Set at insert time, extensible by admin.
  expiresAt      DateTime

  @@index([status, expiresAt])
  @@index([status, expiresAt, lat, lng])
  @@index([createdAt])
}

/// Audit log for every WhatsApp bot ingestion attempt that hits
/// /api/bot/ingest. One row per inbound image POST, regardless of
/// outcome - success (Bhandara/Spot created), duplicate (hash or
/// content), ignored (Gemini classified as non-bhandara), or failed
/// (network / classify / extract / upload errors). Lets the admin
/// answer "why didn't this poster from group X show up?" without
/// re-posting the image, and without grepping bot stdout.
///
/// Keep it lean - no image bytes, no full extracted JSON. Just the
/// signal-bearing fields: who sent it, message id, classification
/// outcome, dedup reason, the resulting Bhandara/Spot row id (when
/// one was created OR matched against), a short human note for the
/// "why was this dropped" cases, and the SHA-256 hash prefix we
/// computed (so the operator can correlate with the [bot:…] tag
/// embedded in description / caption).
///
/// Read by /admin/bot-log; written by /api/bot/ingest at every exit.
model BotIngestionLog {
  id            String   @id @default(cuid())
  // Inbound provenance from the bot agent.
  senderName    String?
  msgId         String?
  groupName     String?
  // What we did with this request.
  //   SUCCESS_BHANDARA      - created a PENDING Bhandara
  //   SUCCESS_SPOT          - created an APPROVED Spot
  //   DUPLICATE_HASH        - exact byte-hash already ingested
  //   DUPLICATE_CONTENT     - same name + date already on file
  //   IGNORED_NON_BHANDARA  - Gemini said off-topic
  //   FAILED_CLASSIFY       - Gemini classify call errored
  //   FAILED_EXTRACT        - Gemini extract call errored
  //   FAILED_UPLOAD         - R2 + Supabase both failed
  //   FAILED_OTHER          - uncaught path / unknown error
  outcome       String
  // Pointer to the Bhandara / Spot row that was created OR that the
  // dedup matched. Lets the admin click straight to the canonical
  // row from the log. NULL when no row exists yet (failed /
  // ignored paths).
  resultRowId   String?
  resultRowKind String? // "bhandara" | "spot"
  // Short human-readable note. e.g. "Gemini said 'other'",
  // "Same name + 2026-05-26 as cmpxyz", "R2 + Supabase both 500".
  reason        String?
  // SHA-256 hash prefix of the normalised WebP bytes (same value
  // embedded into the [bot:…] tag on the canonical row). Powers
  // cross-correlation when the operator is staring at a Bhandara
  // row in the queue and wants to see which forwards produced it.
  imageHash     String?
  // Best-effort extracted name (when extraction got that far).
  // Helps the admin scan the log without opening each row.
  extractedName String?
  createdAt     DateTime @default(now())

  @@index([outcome, createdAt])
  @@index([msgId])
  @@index([imageHash])
  @@index([createdAt])
}

/// Audit row for every "Sponsor this bhandara" tap. We capture the
/// donor's INTENT to pay - bhandara, amount, recipient UPI, optional
/// donor info - at the moment the user taps the button, BEFORE the
/// UPI deep-link opens their bank app. The actual UPI transaction
/// happens entirely between the donor's bank and the recipient's
/// bank; we never see it. So this table is intent-tracking + audit
/// trail, not payment confirmation:
///
///   • CLICKED (default)        - donor opened the UPI app via our link
///   • DONOR_CONFIRMED          - donor came back, hit "Yes, I paid"
///   • ORGANISER_CONFIRMED      - organiser separately confirmed receipt
///   • DISPUTED                 - donor reported "didn't go through"
///   • PG_CONFIRMED             - Razorpay/PG webhook fired (Phase 2)
///
/// Use cases:
///   - Dispute resolution: "I paid ₹501 to <organiser> on <date>"
///   - Analytics: which bhandaras get the most sponsor taps
///   - Abuse detection: rate-limit by ipHash, spot click-bombing
///   - Razorpay onramp: razorpayPaymentId unique-indexed, will hold
///     the bank reference once webhook integration ships
model DonationIntent {
  id              String   @id @default(cuid())
  bhandaraId      String
  bhandara        Bhandara @relation(fields: [bhandaraId], references: [id], onDelete: Cascade)

  /// Suggested INR amount we put in the UPI deep link's `am=` param.
  /// User can override inside their UPI app - what they ACTUALLY pay
  /// is between them and their bank. We just record what we asked for.
  amount          Int

  /// "organiser" - direct UPI to the bhandara organiser's VPA
  /// "platform" - Through-Bada-Mangal mode (deferred until payments
  /// structure is set up; see notes/07-pre-launch-report.md)
  recipientType   String

  /// VPA the deep-link targeted at click time. Captured as a snapshot
  /// in case Bhandara.upiId is edited later - the audit row should
  /// always reflect where the donor was actually sent.
  recipientUpiId  String

  /// Human-readable display name for the audit log
  /// (organiser name OR "Bada Mangal" for platform mode).
  recipientName   String?

  /// Optional donor info - captured when present, never required.
  /// Anonymous donations are first-class.
  donorName       String?
  donorPhone      String?
  donorEmail      String?
  donorMessage    String?

  /// SHA-256 of donor's IP with a per-deploy salt - same pattern as
  /// Spot.ipHash. Lets us detect abuse (one IP firing 100 intents/min)
  /// without storing raw IPs.
  ipHash          String?
  /// Truncated UA string for browser/device hint.
  userAgent       String?

  status          String   @default("CLICKED")
  donorConfirmedAt     DateTime?
  organiserConfirmedAt DateTime?

  /// Razorpay payment_id when the platform-mode webhook fires.
  /// Unique so a duplicate webhook can't double-create rows.
  razorpayPaymentId String? @unique

  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([bhandaraId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}
