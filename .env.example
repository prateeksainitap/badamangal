# ── Required ────────────────────────────────────────────────────────────

# Postgres connection string — copy from Supabase:
#   Project Settings → Database → Connection string → URI (Transaction)
# Make sure to URL-encode the password and add `?pgbouncer=true&connection_limit=1`
# at the end so Prisma plays nice with Supabase's pooler.
# Example:
#   postgres://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=""

# Supabase project + service-role key — used by /api/uploads to push photos
# into the `bhandara-photos` Storage bucket. Without these set, the upload
# endpoint falls back to writing into `/public/uploads` (local dev only;
# fails on serverless hosts since their file system is read-only).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# (Optional) override the bucket name. Defaults to "bhandara-photos".
# SUPABASE_PHOTO_BUCKET="bhandara-photos"

# Public site URL (no trailing slash). Used in OG images, share text,
# canonical URLs, and the ThankYou screen's listing link.
NEXT_PUBLIC_SITE_URL="http://localhost:3030"

# Admin password — protects /admin. Pick a long random string in prod.
# Generate one with:  openssl rand -hex 24
ADMIN_PASSWORD="changeme"

# 32-byte hex secret used to HMAC-sign the phone-verification cookie.
# Generate with:  openssl rand -hex 32
MOD_SECRET=""

# Ola Maps API key for browser + server map calls (tiles, autocomplete,
# reverse-geocode, geocode). Sign up at https://maps.olakrutrim.com,
# create an API key, and LOCK IT to your production domain via the
# "HTTP referrer restrictions" panel — without that lock the key in
# the browser is reusable from any site.
NEXT_PUBLIC_OLA_MAPS_API_KEY=""

# Anthropic API key for the /admin "Scan & publish" flow (Claude
# Sonnet vision reads a WhatsApp invite image and extracts the
# bhandara details). Create at https://console.anthropic.com.
# Without it, the scan endpoint returns 502 with a clear error;
# the rest of the admin works fine.
ANTHROPIC_API_KEY=""


# ── Recommended ─────────────────────────────────────────────────────────

# Google Analytics 4 measurement ID. Without it, all trackEvent() calls
# silently no-op, so it's safe to leave blank in dev.
NEXT_PUBLIC_GA_ID=""

# Search engine verification tokens. Paste the value from the "HTML
# tag" verification method (just the `content` attribute, not the
# whole meta tag). Without these the meta tags simply don't render
# and the site still works — they're only needed once during initial
# Search Console + Bing Webmaster setup.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# NOTE: SMS-OTP verification was retired in favour of the team-callback
# model (every submission lands as PENDING; the team phones the
# organizer to confirm before flipping isVerified=true). No MSG91 or
# DLT setup is required. The form collects the phone number purely
# so the team can call back; nothing else is sent to it.


# ── Optional ────────────────────────────────────────────────────────────

# Extra comma-separated banned terms layered onto the live-feed moderator.
# MOD_BANNED_TERMS_EXTRA=""
