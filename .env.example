# ── Required ────────────────────────────────────────────────────────────

# Postgres connection string — copy from Supabase:
#   Project Settings → Database → Connection string → URI (Transaction)
# Make sure to URL-encode the password and add `?pgbouncer=true&connection_limit=1`
# at the end so Prisma plays nice with Supabase's pooler.
# Example:
#   postgres://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=""

# Supabase project + service-role key — used by /api/uploads to push photos
# into the `bhandara-photos` Storage bucket. Without these set, the upload
# endpoint falls back to writing into `/public/uploads` (local dev only;
# fails on serverless hosts since their file system is read-only).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# (Optional) override the bucket name. Defaults to "bhandara-photos".
# SUPABASE_PHOTO_BUCKET="bhandara-photos"

# Public site URL (no trailing slash). Used in OG images, share text,
# canonical URLs, and the ThankYou screen's listing link.
NEXT_PUBLIC_SITE_URL="http://localhost:3030"

# Admin password — protects /admin. Pick a long random string in prod.
# Generate one with:  openssl rand -hex 24
ADMIN_PASSWORD="changeme"

# 32-byte hex secret used to HMAC-sign the phone-verification cookie.
# Generate with:  openssl rand -hex 32
MOD_SECRET=""


# ── Recommended ─────────────────────────────────────────────────────────

# Google Analytics 4 measurement ID. Without it, all trackEvent() calls
# silently no-op, so it's safe to leave blank in dev.
NEXT_PUBLIC_GA_ID=""

# MSG91 — sends real OTP SMS to organizers verifying their mobile number.
# Without these, OTP is logged to the server console in dev and the code
# `123456` is universally accepted (only when NODE_ENV !== "production").
#
# To go live with real SMS:
#   1. Sign up at https://msg91.com → top-up wallet (~₹500 covers a season)
#   2. Get TRAI DLT-approved (see below) — usually 1–3 business days
#   3. Paste the auth key + DLT-approved template ID here
#
# DLT registration prerequisites (TRAI mandate, India only):
#   • Registered business entity OR sole-proprietor with PAN
#   • PAN card scan, Aadhaar / business address proof
#   • Sender ID (e.g. "BMNGL") — 6 alphanumeric chars
#   • Template content with {#var#} placeholders for the OTP digits
#   Apply via Vodafone-Idea / Jio / Airtel DLT portal (one is enough).
MSG91_API_KEY=""
MSG91_TEMPLATE_ID=""

# Set to "true" to BYPASS the OTP verification step entirely.
# Use during launch week before DLT registration is approved — the
# listing form still collects the phone number but skips the OTP gate
# (server-side check in /api/bhandaras also honours this flag).
# Two env vars are needed because the flag is checked on both client
# (form UI) and server (submission API). Remove or set to "false" once
# MSG91 + DLT are live.
OTP_DISABLED="true"
NEXT_PUBLIC_OTP_DISABLED="true"


# ── Optional ────────────────────────────────────────────────────────────

# Extra comma-separated banned terms layered onto the live-feed moderator.
# MOD_BANNED_TERMS_EXTRA=""
