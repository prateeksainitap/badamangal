# Required: react-day-picker@9.14 declares `peer react ">=16.8.0"` which
# npm's modern strict resolver flags as a conflict with React 19 RC. The
# package actually works fine on React 19 — react-day-picker just hasn't
# published a peer-range bump yet — so we tell npm to use the pre-v7
# resolver behaviour, which is what `npm install --legacy-peer-deps`
# does. Committing this here means CI builds (Netlify, GitHub Actions,
# anyone running `npm ci`) automatically inherit the right behaviour
# without needing a flag.
legacy-peer-deps=true
