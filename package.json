{
  "name": "badamangal",
  "version": "0.1.0",
  "private": true,
  "description": "BadaMangal.com — the digital home of Lucknow's Bada Mangal Bhandara tradition",
  "scripts": {
    "dev": "next dev -p ${PORT:-3030}",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3030}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:init": "prisma db push --accept-data-loss && prisma generate",
    "db:reset": "prisma db push --force-reset --accept-data-loss && prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@2toad/profanity": "^3.3.0",
    "@aws-sdk/client-s3": "^3.1051.0",
    "@headlessui/react": "^2.2.10",
    "@prisma/client": "5.22.0",
    "@supabase/supabase-js": "^2.105.4",
    "@types/qrcode": "^1.5.6",
    "next": "^15.5.18",
    "olamaps-web-sdk": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "19.0.0-rc-66855b96-20241106",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.0.0-rc-66855b96-20241106",
    "resend": "^6.12.3",
    "sharp": "^0.34.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.5.18",
    "postcss": "^8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
